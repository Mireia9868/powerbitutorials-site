---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/hub-design.css";

const tools = [
  {
    href: "/tools/dax-audit/",
    title: "DAX Formatter & Linter",
    tag: "Write better measures",
    body: "Paste a measure and get clean formatting plus a review of the patterns that quietly cost performance — repeated measures, FILTER over ALL, division that breaks on zero, hard-coded dates.",
    meta: "Runs in your browser · no signup",
  },
  {
    href: "/tools/dax-functions/",
    title: "DAX Function Reference",
    tag: "Look it up",
    body: "Every DAX function that shows up in real models, with copyable syntax, a one-line explanation and a working example. Searchable, no video.",
    meta: "64 functions · free",
  },
  {
    href: "/tools/conditional-format-generator/",
    title: "Conditional Formatting Generator",
    tag: "Colour rules",
    body: "Pick thresholds and colours, get the DAX measure for Format by: Field value — plus the six guides that explain when to use it.",
    meta: "DAX output · free",
  },
  {
    href: "/tools/date-table/",
    title: "Date Table Generator",
    tag: "Fix time intelligence",
    body: "A contiguous date table in DAX or Power Query, with a real sort column for every month label, ISO week numbers, and fiscal year handled properly. Includes the mark-as-date-table checklist.",
    meta: "DAX + M output · free",
  },
  {
    href: "/tools/license-calculator/",
    title: "Power BI Licence Calculator",
    tag: "Budget it",
    body: "Pro, Premium Per User, or the mix most teams end up on. Enter how many people build reports and how many only read them, and see the yearly total.",
    meta: "US list prices · updated Nov 2026",
  },
];
---

<BaseLayout
  title="Free Power BI Tools"
  description="Three free browser-based Power BI tools: a DAX formatter and linter, a date table generator for DAX and Power Query M, and a licence calculator. No signup."
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;600&family=Inter:wght@400;500;600&family=Newsreader:wght@600;700&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="hub-v2">
    <!-- Hero -->
    <section class="hero">
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="wrap">
        <div>
          <p class="kicker">Tools / 02</p>
          <h1>Free tools for the parts that waste your afternoon</h1>
          <p class="hero__sub">
            Small, single-purpose utilities that run in the browser. No account,
            no upload, no “start your free trial”. Each one exists because writing
            the same thing by hand for the tenth time is not a good use of an analyst.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="/tools/dax-audit/">Open DAX Formatter</a>
            <a class="btn btn--secondary" href="#toolbox">See all tools</a>
          </div>
        </div>
        <div class="preview">
          <p class="preview__tag">TOOL / DAX FORMATTER</p>
          <p class="preview__title preview__title--code">Measure =
DIVIDE( [Revenue], [Budget] )</p>
          <p class="preview__spec">01   PASTE A MEASURE
02   GET CLEAN FORMATTING
03   REVIEW THE PATTERNS</p>
        </div>
      </div>
    </section>

    <!-- Toolbox -->
    <section class="section section--base" id="toolbox">
      <div class="wrap">
        <div class="section__head">
          <p class="kicker">01 / The toolbox</p>
          <h2>Five tools. One job each.</h2>
          <p class="section__intro">
            Everything runs client-side. The DAX you paste is never sent to a
            server — you can open the page, disconnect from the network, and it
            still works.
          </p>
        </div>
        <div class="card-grid">
          {tools.map((tool) => (
            <article class="card">
              <p class="card__badge">{tool.tag}</p>
              <h3>{tool.title}</h3>
              <p class="card__desc">{tool.body}</p>
              <p class="card__meta">{tool.meta}</p>
              <a class="card__link" href={tool.href}>Open tool <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8H13M9 3.5L13.5 8 9 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </article>
          ))}
          <article class="card card--next">
            <p class="card__badge">More coming</p>
            <h3>Built when the gap is real</h3>
            <p class="card__desc">
              No tool that tries to do everything. If a repeated task shows up in
              real models, it gets a single-purpose utility here.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section--tint">
      <div class="wrap">
        <div class="section__head">
          <p class="kicker">02 / Good questions</p>
          <h2>Why so few?</h2>
        </div>
        <div class="faq-row">
          <span class="faq-row__num">01</span>
          <div>
            <h3>Why so few tools?</h3>
            <p>
              Because a tool that tries to do everything ends up being a worse
              version of Power BI Desktop. These tools cover the gaps where the
              desktop app gives you no help at all: formatting a formula you pasted
              from somewhere, building a date table that survives time intelligence,
              and working out what the licences will actually cost.
            </p>
          </div>
        </div>
        <div class="faq-row">
          <span class="faq-row__num">02</span>
          <div>
            <h3>Is my DAX sent anywhere?</h3>
            <p>
              No. Everything runs client-side. Open the page, disconnect from the
              network, and it still works.
            </p>
          </div>
        </div>
        <div class="faq-row">
          <span class="faq-row__num">03</span>
          <div>
            <h3>Where do I start?</h3>
            <p>
              Start with the <a href="/tutorials/dax-basics/">DAX basics guide</a>,
              or read <a href="/tutorials/dax-troubleshooting-guide/">the fifteen DAX
              errors that look cryptic</a> — both explain the reasoning behind the
              checks rather than just the output.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="section section--soft final-cta">
      <div class="wrap">
        <p class="kicker">03 / Keep going</p>
        <h2 class="statement">Fix the model, not just the measure.</h2>
        <a class="btn btn--primary buy-btn" data-pack="finance-starter-pack" href="https://www.creem.io/payment/prod_2LHa27X5bFbdUZA4F3KiWe" rel="noopener">Buy Finance Starter Pack · $39 →</a>
      </div>
    </section>
  </div>
</BaseLayout>
