---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TutorialCard from "../components/TutorialCard.astro";
import AdSlot from "../components/AdSlot.astro";
import { CATEGORIES, SITE_DESCRIPTION } from "../consts";

const allTutorials = (await getCollection("tutorials", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featured = allTutorials.filter((t) => t.data.featured).slice(0, 3);
const featuredFallback = featured.length > 0 ? featured : allTutorials.slice(0, 3);
const latest = allTutorials.slice(0, 6);

const tutorialCount = allTutorials.length;
---

<BaseLayout description={SITE_DESCRIPTION}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <span class="hero-eyebrow">Power BI · DAX · Power Query</span>
        <h1>
          Master Power BI, one<br />
          <span class="hero-accent">practical tutorial</span> at a time.
        </h1>
        <p class="hero-sub">
          {tutorialCount}+ hands-on tutorials for data analysts. From your first DAX
          measure to advanced time intelligence patterns — clear explanations,
          real datasets, copy-paste code.
        </p>
        <div class="hero-cta">
          <a href="/tutorials/" class="btn btn-primary">Browse Tutorials</a>
          <a href="/tutorials/dax-basics/" class="btn btn-secondary">Start with DAX Basics →</a>
        </div>
        <div class="hero-search">
          <form action="/tutorials/" method="get" class="search-form">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
            </svg>
            <input type="search" name="q" placeholder="Search tutorials… (e.g. CALCULATE, YTD, filter)" aria-label="Search" />
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Featured Tutorials</h2>
          <p class="section-sub">Hand-picked guides every analyst should read first.</p>
        </div>
        <a href="/tutorials/" class="section-link">View all →</a>
      </div>
      <div class="card-grid-3">
        {featuredFallback.map((t) => <TutorialCard tutorial={t} />)}
      </div>
    </div>
  </section>

  <div class="container"><AdSlot label="In-feed Ad" /></div>

  <!-- Categories -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Browse by Category</h2>
          <p class="section-sub">Jump straight to the topic you need.</p>
        </div>
      </div>
      <div class="cat-grid">
        {CATEGORIES.map((cat) => (
          <a href={`/category/${cat.slug}`} class="cat-card">
            <div class="cat-icon" aria-hidden="true">
              {cat.slug === "dax" && "ƒ"}
              {cat.slug === "power-query" && "⇄"}
              {cat.slug === "data-modeling" && "◈"}
              {cat.slug === "visualization" && "▤"}
              {cat.slug === "time-intelligence" && "◷"}
            </div>
            <h3>{cat.label}</h3>
            <p>{cat.description}</p>
            <span class="cat-arrow">Explore →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Latest Tutorials</h2>
          <p class="section-sub">Fresh from the editor — published weekly.</p>
        </div>
        <a href="/tutorials/" class="section-link">View all →</a>
      </div>
      <div class="card-grid-3">
        {latest.map((t) => <TutorialCard tutorial={t} />)}
      </div>
    </div>
  </section>

  <!-- Newsletter CTA -->
  <section class="section section-cta">
    <div class="container cta-inner">
      <div class="cta-text">
        <h2>One DAX pattern. Every week. Free.</h2>
        <p>Join 2,000+ analysts getting one practical, copy-paste DAX pattern in their inbox every Tuesday. No spam, unsubscribe anytime.</p>
      </div>
      <form class="cta-form" onsubmit="return false;">
        <input type="email" placeholder="you@company.com" aria-label="Email address" required />
        <button type="submit">Subscribe Free</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 72px 0 64px;
    background:
      radial-gradient(ellipse 60% 50% at 50% 0%, rgba(242,200,17,0.15), transparent 70%),
      var(--c-bg);
    border-bottom: 1px solid var(--c-border);
  }
  .hero-inner { max-width: 820px; }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--c-accent-dark);
    background: var(--c-accent-soft);
    border: 1px solid var(--c-accent-border);
    padding: 4px 12px;
    border-radius: 999px;
    letter-spacing: 0.04em;
    margin-bottom: 20px;
  }
  .hero h1 {
    font-size: 2.9rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 18px;
  }
  .hero-accent { color: var(--c-accent-dark); }
  .hero-sub {
    font-size: 1.1rem;
    color: var(--c-text-muted);
    max-width: 600px;
    margin-bottom: 28px;
  }
  .hero-cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .btn {
    display: inline-block;
    padding: 12px 22px;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }
  .btn-primary {
    background: var(--c-accent);
    color: var(--c-accent-text);
  }
  .btn-primary:hover { background: var(--c-accent-hover); text-decoration: none; }
  .btn-secondary {
    background: var(--c-bg);
    color: var(--c-text);
    border-color: var(--c-border);
  }
  .btn-secondary:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
    text-decoration: none;
  }
  .hero-search { max-width: 480px; }
  .search-form {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    color: var(--c-text-dim);
    transition: border-color 0.15s ease;
  }
  .search-form:focus-within { border-color: var(--c-accent); }
  .search-form input {
    flex: 1;
    border: none;
    background: none;
    color: var(--c-text);
    font-size: 0.95rem;
    font-family: inherit;
  }
  .search-form input:focus { outline: none; }

  .section { padding: 64px 0; border-bottom: 1px solid var(--c-border); }
  .section-soft { background: var(--c-bg-soft); }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 32px;
    gap: 16px;
  }
  .section-head h2 { margin: 0; font-size: 1.85rem; }
  .section-sub { color: var(--c-text-muted); margin: 6px 0 0; font-size: 0.95rem; }
  .section-link { font-weight: 600; font-size: 0.9rem; white-space: nowrap; }

  .card-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }
  .cat-card {
    display: flex;
    flex-direction: column;
    padding: 24px 20px;
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .cat-card:hover {
    border-color: var(--c-accent-border);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -12px rgba(242,200,17,0.3);
    text-decoration: none;
  }
  .cat-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background: var(--c-accent);
    color: var(--c-accent-text);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    font-weight: 800;
    margin-bottom: 14px;
  }
  .cat-card h3 { font-size: 1rem; margin-bottom: 4px; }
  .cat-card p { font-size: 0.82rem; color: var(--c-text-muted); margin-bottom: 12px; flex: 1; }
  .cat-arrow { font-size: 0.82rem; font-weight: 700; color: var(--c-accent-dark); }

  .section-cta { background: var(--c-bg-soft); }
  .cta-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    align-items: center;
    padding: 48px 24px;
  }
  .cta-text h2 { font-size: 1.85rem; margin-bottom: 10px; }
  .cta-text p { color: var(--c-text-muted); margin: 0; }
  .cta-form {
    display: flex;
    gap: 8px;
  }
  .cta-form input {
    flex: 1;
    padding: 12px 14px;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-bg);
    color: var(--c-text);
    font-size: 0.95rem;
    font-family: inherit;
  }
  .cta-form input:focus { outline: none; border-color: var(--c-accent); }
  .cta-form button {
    padding: 12px 20px;
    background: var(--c-accent);
    color: var(--c-accent-text);
    border: none;
    border-radius: var(--radius);
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }
  .cta-form button:hover { background: var(--c-accent-hover); }

  @media (max-width: 960px) {
    .card-grid-3 { grid-template-columns: repeat(2, 1fr); }
    .cat-grid { grid-template-columns: repeat(3, 1fr); }
    .cta-inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero { padding: 48px 0 40px; }
    .hero h1 { font-size: 2rem; }
    .card-grid-3 { grid-template-columns: 1fr; }
    .cat-grid { grid-template-columns: repeat(2, 1fr); }
    .cta-form { flex-direction: column; }
  }
</style>
