---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_URL } from "../consts";
---

<BaseLayout
  title="Terms of Service"
  description="Terms and conditions for powerbitutorials.com: permitted use of tutorials and code samples, intellectual property, advertising, and limitation of liability."
>
  <article class="legal-page">
    <div class="content-width">
      <span class="page-eyebrow">Legal</span>
      <h1>Terms of Service</h1>
      <p class="updated">Last updated: November 24, 2026</p>

