---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { NEWSLETTER } from "../../consts";
---

<BaseLayout
  title="Free Time Intelligence Starter Pack"
  description="A marked date table and 12 time-intelligence measures for Power BI, with the three bugs that make TOTALYTD return the wrong number."
>
  <article class="lp">
    <div class="content-width">

      <span class="page-eyebrow">Free download</span>
      <h1>The 12 time-intelligence measures every Power BI model needs</h1>

      <p class="lede">
        Built for the models where <code>TOTALYTD</code> returns a number that
        looks right and isn't.
      </p>

      <ul class="bullets">
        <li>
          <strong>A date table script with fiscal-year support.</strong>
          One Power Query file. Set the start month, mark the table, done.
        </li>
        <li>
          <strong>12 measures, commented.</strong>
          YTD, QTD, MTD, YoY, MoM, rolling 3M and 12M, variance to target, share
          of total — each one explains the trap it is avoiding.
        </li>
        <li>
          <strong>The three bugs that produce wrong numbers silently.</strong>
          Fiscal-year <code>TOTALYTD</code>, <code>PREVIOUSMONTH</code> vs
          <code>DATEADD</code>, and <code>ALL()</code> where you meant
          <code>ALLSELECTED()</code>.
        </li>
      </ul>

      <!-- TODO: replace the img src with a real screenshot of the measure list.
           A visible preview lifts the conversion rate more than any copy change. -->
      <figure class="preview">
        <img
          src="/images/time-intelligence-pack-preview.png"
          alt="The 12 measures listed in the Power BI field list, grouped in a _Measures table"
          loading="lazy"
          width="1200"
          height="675"
        />
        <figcaption>All twelve measures live in one <code>_Measures</code> table.</figcaption>
      </figure>

      <section class="signup">
        <h2>Get the pack</h2>
        <p class="signup-sub">One email with the download link. Then one email a week about a Power BI problem worth fixing.</p>

        <!-- Buttondown 免费档没有 Automations（$29/月），所以不能靠 welcome email 交付。
             这里改成：提交进 Buttondown（后台 double opt-in 会给用户发确认信），
             同时页面上直接放出下载链接 —— 用户不必等任何邮件就能拿到文件。
             代价是假邮箱也能下载，但这是免费包，不值得为此加摩擦。 -->
        <form
          class="signup-form"
          id="pack-form"
          action={NEWSLETTER.action}
          method="post"
          target={NEWSLETTER.iframeName}
        >
          <label class="sr-only" for="email">Email address</label>
          <input
            id="email"
            type="email"
            name={NEWSLETTER.fieldName}
            placeholder="you@company.com"
            autocomplete="email"
            required
          />
          <button type="submit">Send me the pack</button>
        </form>
        <iframe name={NEWSLETTER.iframeName} style="display:none" title="subscription"></iframe>

        <div class="reveal" id="pack-reveal" hidden>
          <p class="reveal-title">Your download is ready</p>
          <a class="reveal-link"
             href="https://drive.google.com/drive/folders/1OoTyeEJI_EB10MtrtA9PFW07wBtRTpaI"
             target="_blank" rel="noopener">
            Open the Time Intelligence Starter Pack →
          </a>
          <p class="reveal-note">
            It opens a Google Drive folder with three files. Start with README.md.
          </p>
        </div>

        <noscript>
          <p class="fineprint">
            JavaScript is off, so the download link can't appear here.
            Email <a href="mailto:hello@powerbitutorials.com">hello@powerbitutorials.com</a>
            and I'll send the pack directly.
          </p>
        </noscript>

        <p class="fineprint">
          No spam. Unsubscribe in one click. I don't sell or share your address.
        </p>
      </section>

      <section class="who">
        <h2>Who made this</h2>
        <p>
          Mireia, who writes the Power BI tutorials at
          <a href="/tutorials/">powerbitutorials.com</a>. Every measure in this
          pack is one I use in real models, and every warning in the README is
          a bug I have shipped at least once.
        </p>
        <p>
          If a measure misbehaves on your model,
          <a href="/contact">tell me</a> — corrections go into the next version
          and everyone who downloaded gets the update.
        </p>
      </section>

    </div>
  </article>
<script is:inline>
  (function () {
    var form = document.getElementById("pack-form");
    var reveal = document.getElementById("pack-reveal");
    if (!form || !reveal) return;
    form.addEventListener("submit", function () {
      // 表单提交到隐藏 iframe，页面不会跳转；
      // 稍等一拍再把链接亮出来，避免用户以为是表单校验失败。
      setTimeout(function () {
        reveal.hidden = false;
        reveal.scrollIntoView({ behavior: "smooth", block: "center" });
        if (window.gtag) window.gtag("event", "lead_magnet_download", {
          pack: "time_intelligence",
        });
      }, 500);
    });
  })();
</script>
</BaseLayout>

<style>
  .lp { padding: 56px 0 96px; }
  .page-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--c-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .lp h1 {
    font-size: 2.3rem;
    line-height: 1.22;
    margin-bottom: 18px;
    max-width: 22ch;
  }
  .lede {
    font-size: 1.12rem;
    color: var(--c-text-muted);
    border-left: 3px solid var(--c-accent);
    padding-left: 18px;
    margin-bottom: 34px;
    max-width: 60ch;
  }
  .bullets { list-style: none; padding: 0; margin: 0 0 40px; max-width: 68ch; }
  .bullets li {
    padding: 16px 0 16px 30px;
    border-bottom: 1px solid var(--c-border);
    position: relative;
    color: var(--c-text-muted);
    line-height: 1.65;
  }
  .bullets li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--c-accent);
    font-weight: 700;
  }
  .bullets strong { color: var(--c-text); }
  .preview { margin: 0 0 44px; }
  .preview img {
    width: 100%;
    height: auto;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    display: block;
  }
  .preview figcaption {
    font-size: 0.85rem;
    color: var(--c-text-dim);
    margin-top: 10px;
  }
  .signup {
    background: var(--c-bg-soft);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: 32px;
    margin-bottom: 44px;
  }
  .signup h2 { margin: 0 0 8px; font-size: 1.35rem; }
  .signup-sub { color: var(--c-text-muted); margin: 0 0 20px; font-size: 0.95rem; }
  .signup-form { display: flex; gap: 10px; flex-wrap: wrap; }
  .signup-form input {
    flex: 1 1 260px;
    padding: 12px 14px;
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius);
    font-size: 1rem;
    background: var(--c-bg);
    color: var(--c-text);
  }
  .signup-form button {
    padding: 12px 24px;
    background: var(--c-accent);
    color: var(--c-accent-text);
    border: none;
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .signup-form button:hover { background: var(--c-accent-hover); }
  .reveal {
    margin-top: 20px;
    padding: 20px;
    border: 1px solid var(--c-accent);
    border-radius: var(--radius);
    background: var(--c-bg);
  }
  .reveal-title {
    font-weight: 700;
    margin: 0 0 10px;
    color: var(--c-accent);
  }
  .reveal-link {
    display: inline-block;
    font-weight: 600;
    font-size: 1.02rem;
  }
  .reveal-note {
    font-size: 0.85rem;
    color: var(--c-text-dim);
    margin: 10px 0 0;
  }
  .fineprint {
    font-size: 0.82rem;
    color: var(--c-text-dim);
    margin: 14px 0 0;
  }
  .who { max-width: 68ch; }
  .who h2 { font-size: 1.25rem; margin-bottom: 12px; }
  .who p { color: var(--c-text-muted); line-height: 1.7; }
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 640px) {
    .lp h1 { font-size: 1.8rem; }
    .signup { padding: 24px 20px; }
  }
</style>
