---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import TutorialCard from "../../components/TutorialCard.astro";
import { CATEGORIES } from "../../consts";

export async function getStaticPaths() {
  return CATEGORIES.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;

const tutorials = (await getCollection("tutorials", ({ slug, data }) => !data.draft && !slug.startsWith("de-")))
  .filter((t) => t.data.category === category.slug)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title={category.label}
  description={category.metaDescription || category.description}
>
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/tutorials/">Tutorials</a>
        <span aria-hidden="true">/</span>
        <span>{category.label}</span>
      </nav>
      <span class="page-eyebrow">Category</span>
      <h1>{category.label}</h1>
      <div class="page-heading-row">
        <p class="page-sub">{category.description}</p>
        <p class="page-count">· {tutorials.length} tutorial{tutorials.length === 1 ? "" : "s"}</p>
      </div>
    </div>
  </div>

  {category.intro && category.intro.length > 0 && (
    <section class="category-intro">
      <div class="container">
        <details class="intro-fold">
          <summary class="intro-fold__summary">
            <span class="intro-fold__head">
              <svg class="intro-fold__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="intro-fold__title">About {category.label}</span>
              <span class="intro-fold__time">2 min read</span>
            </span>
            <span class="intro-fold__lead">{category.introLead}</span>
            <span class="intro-fold__cta">
              <span class="intro-fold__cta-closed">Read the full introduction</span>
              <span class="intro-fold__cta-open">Show less</span>
              <svg class="intro-fold__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </summary>
          <div class="intro-fold__body">
            {category.intro.map((para, i) => (
              <div class="intro-fold__section">
                {category.introHeadings?.[i] && <h2 class="intro-fold__heading">{category.introHeadings[i]}</h2>}
                <p>{para}</p>
              </div>
            ))}
          </div>
        </details>
      </div>
    </section>
  )}

  <div class="container tutorials-layout">
    <Sidebar />

    <div class="tutorials-main">
      {tutorials.length > 0 ? (
        <div class="tutorial-grid">
          {tutorials.map((t) => <TutorialCard tutorial={t} />)}
        </div>
      ) : (
        <div class="empty-state">
          <h3>No tutorials here yet</h3>
          <p>We're working on it. Check back soon, or browse other categories.</p>
          <a href="/tutorials" class="btn-primary">Browse All Tutorials</a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .category-intro {
    padding: 14px 0 10px;
    border-bottom: 1px solid var(--c-border);
  }
  .intro-fold {
    border: 1px solid var(--c-accent-border);
    background: var(--c-accent-soft);
    border-radius: var(--radius);
  }
  .intro-fold__summary {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 16px 12px;
    cursor: pointer;
    list-style: none;
  }
  .intro-fold__summary::-webkit-details-marker { display: none; }
  .intro-fold__summary::marker { content: ""; }
  .intro-fold__head {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .intro-fold__icon { flex: none; color: var(--c-accent-dark); }
  .intro-fold__title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--c-accent-dark);
  }
  .intro-fold__time {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--c-text-dim);
  }
  .intro-fold__lead {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--c-text-muted);
  }
  .intro-fold__cta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--c-accent-dark);
  }
  .intro-fold__summary:hover .intro-fold__cta { color: var(--c-text); }
  .intro-fold__cta-open,
  .intro-fold[open] .intro-fold__cta-closed { display: none; }
  .intro-fold[open] .intro-fold__cta-open { display: inline; }
  .intro-fold__chevron { transition: transform 0.15s ease; }
  .intro-fold[open] .intro-fold__chevron { transform: rotate(180deg); }
  .intro-fold__body {
    max-width: 760px;
    padding: 0 16px 16px;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--c-text-muted);
  }
  .intro-fold__section { margin-top: 14px; }
  .intro-fold__heading {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--c-accent-dark);
    margin-bottom: 5px;
  }
  .intro-fold__body p { margin: 0; }

  .page-header {
    padding: 20px 0 14px;
    border-bottom: 1px solid var(--c-border);
    background: var(--c-bg-soft);
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--c-text-dim);
    margin-bottom: 10px;
  }
  .breadcrumb a { color: var(--c-text-dim); }
  .breadcrumb a:hover { color: var(--c-accent); }
  .page-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--c-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .page-header h1 { font-size: 2.2rem; margin-bottom: 6px; }
  .page-heading-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }
  .page-sub { color: var(--c-text-muted); margin: 0; }
  .page-count { font-size: 0.85rem; color: var(--c-text-dim); margin: 0; }

  .tutorials-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 40px;
    padding: 40px 24px 80px;
  }
  .tutorial-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }
  .empty-state {
    text-align: center;
    padding: 64px 24px;
    background: var(--c-bg-soft);
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius-lg);
  }
  .empty-state h3 { margin-bottom: 8px; }
  .empty-state p { margin-bottom: 20px; }
  .btn-primary {
    display: inline-block;
    padding: 11px 22px;
    background: var(--c-accent);
    color: var(--c-accent-text);
    border-radius: var(--radius);
    font-weight: 700;
    text-decoration: none;
  }
  .btn-primary:hover { background: var(--c-accent-hover); text-decoration: none; }

  @media (max-width: 960px) {
    .tutorials-layout { grid-template-columns: 1fr; }
    .tutorial-grid { grid-template-columns: 1fr; }
  }
</style>
