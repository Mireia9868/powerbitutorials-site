---
import BaseLayout from "../layouts/BaseLayout.astro";
import { GUMROAD_TIME_INTELLIGENCE, SITE_URL } from "../consts";

const products = [
  {
    name: "Time Intelligence Starter Pack",
    price: "$9",
    status: "Available now",
    statusClass: "live",
    summary:
      "A fiscal-ready date table and 12 commented time-intelligence measures. Three plain-text files, nothing to install.",
    includes: [
      "DateTable.pq — contiguous dates, ISO weeks, fiscal year/quarter/month",
      "Measures.dax — 12 measures, each with the trap it avoids",
      "README.md — setup order, sort columns, troubleshooting",
    ],
    href: GUMROAD_TIME_INTELLIGENCE,
    cta: "Buy · $9",
    note: "One-time payment. Instant download after checkout.",
  },
  {
    name: "Finance Starter Pack",
    price: "$39",
    status: "In development",
    statusClass: "soon",
    summary:
      "P&L star schema, 46 audited measures, four page blueprints and 1,728 rows of sample data that reconcile.",
    includes: [
      "Five CSVs, a fixed seed and a regeneration script",
      "46 measures in four display folders",
      "Model spec, page blueprints and a theme JSON",
    ],
    href: "/templates/finance-starter/",
    cta: "See what's in it",
    note: "Not on sale yet — the PBIX has to be assembled and checked on Windows first.",
  },
];

const faqs = [
  {
    q: "Is this a subscription?",
    a: "No. Every pack is a one-time payment. There is no recurring charge, no per-seat pricing and no account to keep alive.",
  },
  {
    q: "What happens when you update a pack?",
    a: "Buyers get corrections for 12 months at no cost. When a measure is fixed or a step in the README is wrong, the file is replaced and everyone who bought it is notified through the checkout platform.",
  },
  {
    q: "Can I use a pack in client work?",
    a: "Yes. The licence covers your own reports and paid client work. What it does not cover is reselling, redistributing or republishing the files as your own template, course or product.",
  },
  {
    q: "How do refunds work?",
    a: "Thirty days, any reason. Reply to your receipt or email hello@powerbitutorials.com and the payment is returned. If a measure is wrong for your model, tell me what it does — I would rather fix it than refund it.",
  },
  {
    q: "Who handles payment and tax?",
    a: "Checkout is handled by a merchant of record, which means VAT, sales tax and invoicing are their responsibility, not yours. Prices are shown in US dollars.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Power BI Tutorials — packs and pricing",
  itemListElement: products.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Product",
      name: p.name,
      description: p.summary,
      url: p.href.startsWith("http") ? p.href : `${SITE_URL}${p.href}`,
      ...(p.price === "$9"
        ? {
            offers: {
              "@type": "Offer",
              price: "9.00",
              priceCurrency: "USD",
              availability: "https://schema.org/InStock",
              url: p.href,
            },
          }
        : {
            offers: {
              "@type": "Offer",
              price: "39.00",
              priceCurrency: "USD",
              availability: "https://schema.org/PreOrder",
            },
          }),
    },
  })),
};
---

<BaseLayout
  title="Pricing — Power BI Tutorials packs"
  description="One-time prices for Power BI starter packs: a $9 time-intelligence pack available now, and a $39 finance pack in development. No subscriptions, 30-day refunds, commercial use included."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="lp pricing">
    <div class="content-width">

      <span class="page-eyebrow">Pricing</span>
      <h1>One price, paid once.</h1>

      <p class="lede">
        No subscriptions, no per-seat pricing, no "contact sales". Every pack is a
        one-time payment, and the free tools stay free.
      </p>

      <div class="price-grid">
        {products.map((p) => (
          <section class="price-card">
            <header>
              <h2>{p.name}</h2>
              <span class={`status ${p.statusClass}`}>{p.status}</span>
            </header>
            <p class="price-amount">{p.price}</p>
            <p class="price-summary">{p.summary}</p>
            <ul>
              {p.includes.map((item) => <li>{item}</li>)}
            </ul>
            <a class="buy-btn" href={p.href} rel="noopener">{p.cta} →</a>
            <p class="fineprint">{p.note}</p>
          </section>
        ))}
      </div>

      <h2>What every purchase includes</h2>
      <ul class="bullets">
        <li>
          <strong>Commercial use.</strong> Use the files in your own reports and
          in paid client work. The only thing excluded is reselling or
          republishing them as your own product.
        </li>
        <li>
          <strong>Twelve months of corrections.</strong> If a formula is wrong or
          a setup step is unclear, the file is replaced and buyers are notified.
        </li>
        <li>
          <strong>A thirty-day refund, any reason.</strong> No form, no
          interrogation — reply to the receipt and the payment goes back.
        </li>
        <li>
          <strong>Plain text.</strong> Power Query scripts, DAX files and Markdown.
          No PBIX lock-in, no custom visuals, nothing that breaks on a Power BI
          update.
        </li>
      </ul>

      <h2>Payment, tax and invoicing</h2>
      <p>
        Checkout runs through a merchant of record, so VAT and sales tax are
        calculated and remitted at checkout and the invoice comes from them, not
        from this site. Prices are in US dollars; your card issuer applies
        whatever conversion it applies.
      </p>

      <h2>Free tools</h2>
      <p>
        The DAX formatter and linter, the function reference, the date table
        generator and the conditional formatting generator are free, need no
        account, and run entirely in your browser.
        <a href="/tools/">Open the tools →</a>
      </p>

      <h2>Questions</h2>
      <ul class="faq-list">
        {faqs.map((f) => (
          <li>
            <p class="faq-q">{f.q}</p>
            <p>{f.a}</p>
          </li>
        ))}
      </ul>

      <p class="fineprint">
        Something not covered here? Email
        <a href="mailto:hello@powerbitutorials.com">hello@powerbitutorials.com</a>
        — the same address that appears on the
        <a href="/contact/">contact page</a>, and the one used for purchases and
        refunds.
      </p>

    </div>
  </article>
</BaseLayout>

<style>
  .pricing { padding: 56px 0 96px; }
  .page-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin-bottom: 10px;
  }
  .lede {
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--c-text-muted);
    max-width: 62ch;
  }
  .bullets { padding-left: 20px; margin: 18px 0 0; }
  .bullets li { margin-bottom: 12px; line-height: 1.6; }
  .buy-btn {
    display: inline-block;
    padding: 12px 20px;
    border-radius: 8px;
    background: var(--c-accent);
    color: var(--c-accent-text);
    font-weight: 700;
    text-decoration: none;
  }
  .buy-btn:hover { opacity: 0.9; }
  .fineprint { font-size: 0.82rem; color: var(--c-text-dim); line-height: 1.6; }
  .price-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin: 36px 0 48px;
  }
  .price-card {
    border: 1px solid var(--c-border);
    border-radius: 14px;
    padding: 26px 26px 22px;
    background: var(--c-bg);
    display: flex;
    flex-direction: column;
  }
  .price-card header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .price-card h2 { font-size: 1.15rem; margin: 0; }
  .status {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 5px;
    white-space: nowrap;
  }
  .status.live { background: #e7f6ec; color: #1d6b3a; }
  .status.soon { background: #fdf3d6; color: #7a5a00; }
  .price-amount {
    font-family: var(--c-font-mono, ui-monospace, monospace);
    font-size: 2.1rem;
    font-weight: 700;
    margin: 14px 0 10px;
    letter-spacing: -0.02em;
  }
  .price-summary { color: var(--c-text-muted); margin: 0 0 16px; }
  .price-card ul {
    margin: 0 0 22px;
    padding-left: 18px;
    color: var(--c-text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    flex: 1;
  }
  .price-card ul li { margin-bottom: 7px; }
  .price-card .buy-btn { align-self: flex-start; }
  .price-card .fineprint { margin-top: 14px; }
  .faq-list { list-style: none; padding: 0; margin: 0; }
  .faq-list li {
    padding: 18px 0;
    border-bottom: 1px solid var(--c-border);
  }
  .faq-list li:last-child { border-bottom: 0; }
  .faq-q { font-weight: 700; margin: 0 0 6px; }
  .faq-list p:last-child { margin: 0; color: var(--c-text-muted); }
</style>
