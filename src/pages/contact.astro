---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Get in touch with the DAX Guide team — topic requests, error reports, partnership inquiries, and general feedback."
>
  <div class="contact-page">
    <div class="content-width">
      <span class="page-eyebrow">Contact</span>
      <h1>Get in touch</h1>
      <p class="lede">
        Topic requests, error reports, partnership inquiries — we read
        everything. Pick the channel that fits.
      </p>

      <div class="contact-grid">
        <div class="contact-options">
          <div class="contact-card">
            <div class="contact-icon" aria-hidden="true">✉</div>
            <h3>General &amp; Feedback</h3>
            <p>Questions, suggestions, or just want to say thanks?</p>
            <a href="mailto:hello@powerbitutorials.com">hello@powerbitutorials.com</a>
          </div>
          <div class="contact-card">
            <div class="contact-icon" aria-hidden="true">✎</div>
            <h3>Topic Requests</h3>
            <p>Suggest a tutorial topic. We prioritize the most-requested patterns.</p>
            <a href="mailto:topics@powerbitutorials.com">topics@powerbitutorials.com</a>
          </div>
          <div class="contact-card">
            <div class="contact-icon" aria-hidden="true">⚑</div>
            <h3>Report an Error</h3>
            <p>Spotted something inaccurate? Tell us — we fix it fast and credit you.</p>
            <a href="mailto:errata@powerbitutorials.com">errata@powerbitutorials.com</a>
          </div>
          <div class="contact-card">
            <div class="contact-icon" aria-hidden="true">🤝</div>
            <h3>Partnerships</h3>
            <p>Guest posts, tool reviews, or sponsorship inquiries.</p>
            <a href="mailto:partners@powerbitutorials.com">partners@powerbitutorials.com</a>
          </div>
        </div>

        <form class="contact-form" onsubmit="return false;">
          <h3>Send a message</h3>
          <div class="form-row">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" required />
          </div>
          <div class="form-row">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required />
          </div>
          <div class="form-row">
            <label for="topic">Topic</label>
            <select id="topic" name="topic">
              <option>General feedback</option>
              <option>Topic request</option>
              <option>Report an error</option>
              <option>Partnership</option>
              <option>Other</option>
            </select>
          </div>
          <div class="form-row">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <button type="submit" class="btn-primary">Send Message</button>
          <p class="form-note">
            Note: this is a static demo form. Wire it up to Formspree, Getform,
            or your own endpoint before going live.
          </p>
        </form>
      </div>

      <div class="response-note">
        <strong>Response time:</strong> typically within 2 business days.
        For urgent errata, put "ERRATA" in the subject line.
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page { padding: 56px 0 80px; }
  .page-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--c-accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .contact-page h1 { font-size: 2.4rem; margin-bottom: 16px; }
  .lede { font-size: 1.1rem; color: var(--c-text-muted); margin-bottom: 40px; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 40px;
  }
  .contact-options { display: flex; flex-direction: column; gap: 16px; }
  .contact-card {
    padding: 20px;
    background: var(--c-bg-soft);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }
  .contact-icon {
    font-size: 1.4rem;
    margin-bottom: 8px;
  }
  .contact-card h3 { font-size: 1rem; margin-bottom: 4px; }
  .contact-card p { font-size: 0.85rem; color: var(--c-text-muted); margin-bottom: 8px; }
  .contact-card a { font-weight: 600; font-size: 0.9rem; word-break: break-all; }

  .contact-form {
    padding: 24px;
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
  }
  .contact-form h3 { margin-top: 0; }
  .form-row { margin-bottom: 16px; }
  .form-row label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--c-text-muted);
    margin-bottom: 6px;
  }
  .form-row input,
  .form-row select,
  .form-row textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    background: var(--c-bg);
    color: var(--c-text);
    font-size: 0.92rem;
    font-family: inherit;
  }
  .form-row input:focus,
  .form-row select:focus,
  .form-row textarea:focus {
    outline: none;
    border-color: var(--c-accent);
  }
  .btn-primary {
    width: 100%;
    padding: 12px;
    background: var(--c-accent);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .btn-primary:hover { background: var(--c-accent-hover); }
  .form-note {
    font-size: 0.78rem;
    color: var(--c-text-dim);
    margin-top: 12px;
    margin-bottom: 0;
    text-align: center;
  }
  .response-note {
    padding: 16px 20px;
    background: var(--c-accent-soft);
    border: 1px solid var(--c-accent-border);
    border-radius: var(--radius);
    font-size: 0.9rem;
    color: var(--c-text-muted);
  }
  .response-note strong { color: var(--c-text); }

  @media (max-width: 768px) {
    .contact-grid { grid-template-columns: 1fr; }
    .contact-page h1 { font-size: 1.9rem; }
  }
</style>
