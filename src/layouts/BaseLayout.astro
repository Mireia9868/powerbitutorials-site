---
import "../styles/global.css";
import "../styles/sitewide-experiment.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, SITE_LANG, ADSENSE_CLIENT, GOOGLE_SITE_VERIFICATION, BING_SITE_VERIFICATION, GA4_MEASUREMENT_ID } from "../consts";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: Date;
  noindex?: boolean;
  /** <html lang> 覆盖：德语页要传 "de"，否则屏幕阅读器和搜索引擎都会按英文处理 */
  lang?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og-default.png",
  article = false,
  publishedTime,
  noindex = false,
  lang = SITE_LANG,
} = Astro.props;

// 品牌后缀只在加完之后仍然不超过 60 字符时才加。
// 2026-10：Bing Site Scan 报 59 页 "Title too long"，根源是无条件追加 21 字符。
// 2026-11-16：报告降到 28 页，但线上仍有 5 页标题是 61-62 字符；把上限从 62 收到 60，
// 这几页自动去掉品牌后缀。品牌名不是搜索词，挤掉关键词不划算。
// `npm run check:seo` 会在本地拦下任何超过 55 字符的最终标题。
const BRAND_SUFFIX = " — Power BI Tutorials";
const withSuffix = title ? `${title}${BRAND_SUFFIX}` : "";
// 2026-11: cap lowered from 60 to 55. 60 is "not over the limit", 55 is
// "not truncated" — desktop SERP cuts around 580px. Lowering the cap only
// drops the 19-character brand suffix from titles of 37-55 characters; a
// source title that is itself over 55 still renders over 55, so those get
// rewritten rather than shortened. check-seo-meta.mjs enforces the same 55.
const MAX_FINAL_TITLE = 55;
const pageTitle = !title
  ? SITE_TITLE
  : (withSuffix.length <= MAX_FINAL_TITLE ? withSuffix : title);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const isHomepage = Astro.url.pathname === "/";

// WebSite + Organization JSON-LD (homepage only — sitelinks search box + brand entity)
const websiteJsonLd = isHomepage ? {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: SITE_URL,
      name: "Power BI Tutorials",
      description: SITE_DESCRIPTION,
      publisher: { "@id": `${SITE_URL}/#organization` },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${SITE_URL}/tutorials?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: "Power BI Tutorials",
      url: SITE_URL,
      logo: {
        "@type": "ImageObject",
        url: `${SITE_URL}/favicon.svg`,
      },
    },
  ],
} : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (function () {
        var key = 'pbi-design-ac-202610-v2';
        var url = new URL(window.location.href);
        var requested = url.searchParams.get('design_preview');
        var preview = requested === 'A' || requested === 'C';
        var variant = 'A';
        try {
          var stored = localStorage.getItem(key);
          if (preview) variant = requested;
          else if (stored === 'A' || stored === 'C') variant = stored;
          else {
            var cryptoNumbers = new Uint32Array(1);
            if (window.crypto && window.crypto.getRandomValues) {
              window.crypto.getRandomValues(cryptoNumbers);
              variant = cryptoNumbers[0] % 2 ? 'C' : 'A';
            } else variant = Math.random() < 0.5 ? 'A' : 'C';
            localStorage.setItem(key, variant);
          }
        } catch (e) { variant = preview ? requested : 'A'; }
        document.documentElement.dataset.designVariant = variant;
        document.documentElement.dataset.homeVariant = variant;
        document.documentElement.dataset.designPreview = preview ? 'true' : 'false';
        // Preserve an explicitly selected preview through internal navigation, without changing canonical URLs.
        if (preview) {
          document.addEventListener('click', function (event) {
            var link = event.target.closest('a[href]');
            if (!link || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            var target = new URL(link.href, window.location.href);
            if (target.origin === location.origin && target.pathname !== '/rss.xml' && !target.pathname.includes('.xml')) {
              target.searchParams.set('design_preview', variant);
              link.href = target.href;
            }
          }, true);
        }
      })();
    </script>

    <!-- Primary Meta -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Power BI Tutorials" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Power BI Tutorials" href={new URL("rss.xml", Astro.site)} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- AdSense (仅当配置了 Publisher ID 时加载) -->
    {ADSENSE_CLIENT && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      />
    )}
    {ADSENSE_CLIENT && <meta name="google-adsense-account" content={ADSENSE_CLIENT} />}

    <!-- Google Search Console 验证 (仅当配置了 token 时渲染) -->
    {GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}

    <!-- Bing Webmaster Tools 验证 (仅当配置了 token 时渲染) -->
    {BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />}

    <!-- Google Analytics 4 (仅当配置了 Measurement ID 时加载) -->
    {GA4_MEASUREMENT_ID && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`} />
    )}
    {GA4_MEASUREMENT_ID && (
      <script is:inline define:vars={{ GA4_MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', GA4_MEASUREMENT_ID, {
          anonymize_ip: true,
        });
      </script>
    )}

    <!-- Clarity tracking code for http://powerbitutorials.com/ -->
    <!-- is:inline: keep the official snippet verbatim; Astro must not bundle/defer it. -->
    <script is:inline>
(function(c,l,a,r,i,t,y){
c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
})(window, document, "clarity", "script", "zcdodt8r7a");
    </script>

    <script is:inline>
      (function () {
        var variant = document.documentElement.dataset.designVariant || 'A';
        var preview = document.documentElement.dataset.designPreview === 'true';
        var experiment = 'site_design_ac_202610';
        var consentKey = 'cookie-consent-v1';
        var sentExposure = false;
        window.dataLayer = window.dataLayer || [];
        // Define a function even before the external analytics script finishes loading.
        function consentGranted() {
          try { return localStorage.getItem(consentKey) === 'accepted'; } catch (e) { return false; }
        }
        function emit(name, values) {
          if (preview || !consentGranted() || typeof window.gtag !== 'function') return;
          window.gtag('event', name, Object.assign({experiment_id:experiment, design_variant:variant}, values || {}));
        }
        function exposure() {
          if (sentExposure || preview || !consentGranted()) return;
          sentExposure = true;
          emit('experiment_exposure', {experiment_variant:variant});
        }
        document.addEventListener('DOMContentLoaded', function () {
          exposure();
          document.getElementById('cookie-accept')?.addEventListener('click', function () { setTimeout(exposure, 350); });
          document.addEventListener('click', function (e) {
            var link = e.target.closest('a[href]');
            if (!link) return;
            var destination = new URL(link.href, location.href);
            if (destination.origin !== location.origin) return;
            var path = destination.pathname;
            if (path.startsWith('/tutorials/') && path !== '/tutorials/') emit('design_tutorial_click', {destination:path});
            else if (path.startsWith('/category/')) emit('design_category_click', {destination:path});
            else if (path === '/tutorials/') emit('design_library_click', {destination:path});
          });
          document.addEventListener('submit', function (event) {
            var form = event.target;
            if (form.querySelector('input[name=q]')) emit('design_search', {source_path:location.pathname});
          });
        });
      })();
    </script>
    <!-- WebSite + Organization JSON-LD (homepage only) -->
    {isHomepage && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    )}

    <!-- Fonts: use system stack for performance -->

    <!-- Per-page head additions (tool pages load their stylesheet here) -->
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="visually-hidden">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <!-- 行为事件：出站点击 + 滚动深度
         全部走 consentGranted()，未同意时不发送；gtag 未加载时静默跳过。
         出站点击是联盟收入的唯一可信来源 —— 没有它就无法回答
         「哪篇文章真的带来了收入」。 -->
    <script is:inline>
      (function () {
        var CONSENT_KEY = 'cookie-consent-v1';
        function granted() {
          try { return localStorage.getItem(CONSENT_KEY) === 'accepted'; } catch (e) { return false; }
        }
        function send(name, params) {
          if (!granted()) return;
          if (typeof window.gtag !== 'function') return;
          window.gtag('event', name, params || {});
        }

        // ---- 出站点击 ----
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a) return;
          var url;
          try { url = new URL(a.getAttribute('href'), location.href); } catch (err) { return; }
          if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
          if (url.hostname === location.hostname) return;

          var params = {
            link_domain: url.hostname,
            link_url: url.href,
            source_path: location.pathname
          };
          // 联盟链接额外标记：<a href="..." data-affiliate="datacamp">
          if (a.dataset && a.dataset.affiliate) params.affiliate = a.dataset.affiliate;
          send(params.affiliate ? 'affiliate_click' : 'outbound_click', params);
        }, true);

        // ---- 滚动深度：25 / 50 / 75 / 100，每个只发一次 ----
        var marks = [25, 50, 75, 100], fired = {}, ticking = false;
        function onScroll() {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(function () {
            var doc = document.documentElement;
            var scrollable = doc.scrollHeight - window.innerHeight;
            var pct = scrollable <= 0 ? 100 : Math.round((window.scrollY / scrollable) * 100);
            for (var i = 0; i < marks.length; i++) {
              var m = marks[i];
              if (pct >= m && !fired[m]) {
                fired[m] = true;
                send('scroll_depth', { percent: m, source_path: location.pathname });
              }
            }
            ticking = false;
          });
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        // ---- 搜索：把 query 和结果数一起记下来 ----
        // 零结果查询是最便宜的选题来源，现在完全丢失了。
        document.addEventListener('search:results', function (e) {
          var d = e.detail || {};
          send(d.results > 0 ? 'site_search' : 'site_search_no_results', {
            query: d.query,
            results: d.results
          });
        });
      })();
    </script>
  </body>
</html>
