---
import { NEWSLETTER } from "../consts";

export interface Props {
  headline?: string;
  sub?: string;
}

const {
  headline = "Get the next Power BI tutorial by email",
  sub = "One practical guide a week. No spam, unsubscribe in one click.",
} = Astro.props;
---

<section class="nl-inline">
  <h3>{headline}</h3>
  <p class="nl-sub">{sub}</p>

  <form
    class="nl-form"
    action={NEWSLETTER.action}
    method="post"
    target={NEWSLETTER.iframeName}
    data-nl-form
  >
    <label class="visually-hidden" for="nl-inline-email">Email address</label>
    <input
      id="nl-inline-email"
      type="email"
      name={NEWSLETTER.fieldName}
      placeholder="you@example.com"
      autocomplete="email"
      required
    />
    <button type="submit">Subscribe</button>
  </form>

  <iframe name={NEWSLETTER.iframeName} style="display:none" title="subscription"></iframe>
</section>

<script is:inline>
  // GA4 conversion event. Site-wide key events were 0 before this.
  document.addEventListener("submit", function (e) {
    var f = e.target;
    if (!f || !f.hasAttribute("data-nl-form")) return;
    if (typeof window.gtag === "function") {
      window.gtag("event", "newsletter_subscribe", {
        method: "buttondown",
        location: "tutorial_inline",
      });
    }
  });
</script>

<style>
  .nl-inline {
    margin: 40px 0 24px;
    padding: 24px 28px;
    background: var(--c-bg-soft);
    border: 1px solid var(--c-border);
    border-radius: 10px;
  }
  .nl-inline h3 { margin: 0 0 8px; font-size: 1.12rem; }
  .nl-sub { margin: 0 0 16px; font-size: 0.92rem; color: var(--c-text-muted); }
  .nl-form { display: flex; gap: 10px; flex-wrap: wrap; }
  .nl-form input {
    flex: 1 1 220px;
    min-width: 0;
    padding: 10px 14px;
    border: 1px solid var(--c-border);
    border-radius: 7px;
    font-size: 0.95rem;
    background: var(--c-bg);
    color: var(--c-text);
  }
  .nl-form button {
    padding: 10px 20px;
    border: 0;
    border-radius: 7px;
    background: var(--c-accent);
    color: var(--c-accent-text);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .nl-form button:hover { background: var(--c-accent-dark); }
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
