---
import { NAV_LINKS, SITE_TITLE, LANGUAGE_LINKS } from "../consts";

const pathname = Astro.url.pathname;
const currentLang = pathname.startsWith("/de") ? "de" : "en";
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label={SITE_TITLE}>
      <span class="logo-mark" aria-hidden="true">P</span>
      <span class="logo-text">Power BI<span class="logo-accent">Tutorials</span></span>
    </a>

    <nav class="main-nav" aria-label="Primary">
      <ul>
        {NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} class={isActive(link.href) ? "active" : ""}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="lang-switch">
      <details>
        <summary aria-label="Change language">
          <span aria-hidden="true">{(LANGUAGE_LINKS.find((l) => l.code === currentLang) || LANGUAGE_LINKS[0]).short}</span>
          <span class="caret" aria-hidden="true">▾</span>
        </summary>
        <ul>
          {LANGUAGE_LINKS.map((l) => (
            <li>
              <a
                href={l.href}
                hreflang={l.code}
                lang={l.code}
                aria-current={l.code === currentLang ? "true" : undefined}
                class={l.code === currentLang ? "active" : ""}
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </div>

    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" id="nav-toggle">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-border);
    backdrop-filter: saturate(180%) blur(8px);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1rem;
    color: var(--c-text);
    text-decoration: none;
  }
  .logo:hover { text-decoration: none; }
  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 7px;
    background: var(--c-accent);
    color: var(--c-accent-text);
    font-size: 1rem;
    font-weight: 800;
  }
  .logo-accent { color: var(--c-accent-dark); }
  .header-inner { gap: 10px; }
  .main-nav { margin-left: auto; }
  .main-nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
  }
  .main-nav a {
    display: block;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    color: var(--c-text-muted);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .main-nav a:hover {
    color: var(--c-text);
    background: var(--c-bg-elevated);
    text-decoration: none;
  }
  .main-nav a.active {
    color: var(--c-accent-dark);
    background: var(--c-accent-soft);
  }
  .lang-switch {
    position: relative;
    margin-left: 6px;
  }
  .lang-switch details { position: relative; }
  .lang-switch summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    color: var(--c-text-muted);
    font-weight: 500;
    font-size: 0.9rem;
    user-select: none;
  }
  .lang-switch summary::-webkit-details-marker { display: none; }
  .lang-switch summary:hover { color: var(--c-text); background: var(--c-bg-elevated); }
  .lang-switch .caret { font-size: 0.7rem; opacity: 0.7; }
  .lang-switch ul {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    min-width: 140px;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    box-shadow: 0 12px 28px -12px #00000033;
    z-index: 120;
  }
  .lang-switch ul a {
    display: block;
    padding: 8px 10px;
    border-radius: 6px;
    color: var(--c-text-muted);
    font-size: 0.9rem;
    text-decoration: none;
  }
  .lang-switch ul a:hover { background: var(--c-bg-elevated); color: var(--c-text); text-decoration: none; }
  .lang-switch ul a.active { background: var(--c-accent-soft); color: var(--c-accent-dark); font-weight: 600; }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--c-text);
    border-radius: 2px;
  }

  @media (max-width: 720px) {
    .main-nav {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      background: var(--c-bg);
      border-bottom: 1px solid var(--c-border);
      padding: 12px 24px;
      transform: translateY(-120%);
      transition: transform 0.25s ease;
    }
    .main-nav.open { transform: translateY(0); }
    .header-inner { gap: 10px; }
  .main-nav { margin-left: auto; }
  .main-nav ul {
      flex-direction: column;
      gap: 0;
    }
    .main-nav a { padding: 12px; }
    .nav-toggle { display: flex; }
  }
</style>

<script>
  // 点击语言菜单外部时收起
  document.addEventListener("click", (e) => {
    document.querySelectorAll(".lang-switch details[open]").forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute("open");
    });
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      document.querySelectorAll(".lang-switch details[open]").forEach((d) => d.removeAttribute("open"));
    }
  });

  const toggle = document.getElementById("nav-toggle");
  const nav = document.querySelector(".main-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(!!open));
  });
</script>
