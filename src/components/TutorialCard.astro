---
import { CATEGORIES } from "../consts";
import type { CollectionEntry } from "astro:content";

export interface Props {
  tutorial: CollectionEntry<"tutorials">;
  compact?: boolean;
}

const { tutorial, compact = false } = Astro.props;
const { data } = tutorial;
const category = CATEGORIES.find((c) => c.slug === data.category);
const url = `/tutorials/${tutorial.slug}`;

const diffClass = data.difficulty.toLowerCase();
const dateStr = data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<article class={`tutorial-card ${compact ? "compact" : ""}`}>
  <a href={url} class="card-link">
    {data.heroImage && (
      <div class="card-image">
        <img src={data.heroImage} alt={data.title} loading="lazy" />
      </div>
    )}
    <div class="card-body">
      <div class="card-meta">
        {category && <span class="card-cat">{category.label}</span>}
        <span class={`pill pill-${diffClass}`}>{data.difficulty}</span>
      </div>
      <h3 class="card-title">{data.title}</h3>
      {!compact && <p class="card-desc">{data.description}</p>}
      <div class="card-footer">
        <time datetime={data.pubDate.toISOString()}>{dateStr}</time>
        {data.tags.length > 0 && (
          <span class="card-tags">
            {data.tags.slice(0, 3).map((t) => <span class="tag">#{t}</span>)}
          </span>
        )}
      </div>
    </div>
  </a>
</article>

<style>
  .tutorial-card {
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.2s ease;
  }
  .tutorial-card:hover {
    border-color: var(--c-accent-border);
    box-shadow: 0 8px 24px -12px rgba(5, 150, 105, 0.25);
    transform: translateY(-2px);
  }
  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .card-link:hover { text-decoration: none; }
  .card-image {
    aspect-ratio: 16 / 9;
    background: var(--c-bg-elevated);
    overflow: hidden;
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }
  .card-body { padding: 20px; }
  .compact .card-body { padding: 16px; }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .card-cat {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--c-accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .card-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 8px;
    color: var(--c-text);
  }
  .compact .card-title { font-size: 1rem; }
  .card-desc {
    font-size: 0.88rem;
    color: var(--c-text-muted);
    margin-bottom: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.78rem;
    color: var(--c-text-dim);
  }
  .card-tags { display: flex; gap: 8px; }
  .tag { color: var(--c-text-dim); }
</style>
