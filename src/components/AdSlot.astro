---
import { ADSENSE_CLIENT } from "../consts";

export interface Props {
  slot?: string;
  format?: string;
  responsive?: boolean;
  style?: string;
  label?: string;
}

const {
  slot = "0000000000",
  format = "auto",
  responsive = true,
  style = "display:block",
  label = "Advertisement",
} = Astro.props;

// ADSENSE_CLIENT 为空时不渲染任何 AdSense 元素（含占位盒子）；当前未启用 AdSense
const configured = Boolean(ADSENSE_CLIENT);
---

{configured && (
  <div class="ad-slot" aria-label={label}>
    <ins
      class="adsbygoogle"
      style={style}
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive={responsive ? "true" : "false"}
    />
  </div>
)}

{configured && (
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
)}

<style>
  .ad-slot {
    margin: 32px 0;
    text-align: center;
    min-height: 90px;
  }
  .ad-slot ins {
    display: block;
  }
</style>
