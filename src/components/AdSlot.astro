---
import { ADSENSE_CLIENT } from "../consts";
import { isValidAdSlot } from "../lib/ads";

export interface Props {
  slot?: string;
  format?: string;
  responsive?: boolean;
  style?: string;
  label?: string;
}

const {
  slot = "",
  format = "auto",
  responsive = true,
  style = "display:block",
  label = "Advertisement",
} = Astro.props;

// 只有 client 和真实广告位 ID 都配置好才渲染；否则整块不输出，
// 避免空 <ins> 占着 min-height 在正文里留下一条空白。
const configured = isValidAdSlot(slot);
---

{configured && (
  <div class="ad-slot" aria-label={label}>
    <ins
      class="adsbygoogle"
      style={style}
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
      data-ad-format={format}
      data-full-width-responsive={responsive ? "true" : "false"}
    />
  </div>
)}

{configured && (
  <script is:inline>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
)}

<style>
  .ad-slot {
    margin: 32px 0;
    text-align: center;
    min-height: 90px;
  }
  .ad-slot ins {
    display: block;
  }
</style>
