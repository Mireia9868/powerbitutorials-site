---
interface Props { category: string; size?: number; }
const { category, size = 24 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="category-symbol">
  {category === "dax" && <><path d="M7 4h11M7 20h11M17 4L7 12l10 8" /></>}
  {category === "power-query" && <><ellipse cx="12" cy="5" rx="8.5" ry="3.5"/><path d="M3.5 5v7c0 2 3.8 3.5 8.5 3.5s8.5-1.5 8.5-3.5V5M3.5 12v7c0 2 3.8 3.5 8.5 3.5s8.5-1.5 8.5-3.5v-7" /></>}
  {category === "data-modeling" && <><rect x="9" y="2" width="6" height="5" rx="1"/><rect x="2" y="17" width="6" height="5" rx="1"/><rect x="16" y="17" width="6" height="5" rx="1"/><path d="M12 7v5M5 17v-5h14v5"/></>}
  {category === "visualization" && <><rect x="3" y="13" width="4" height="8" rx=".5"/><rect x="10" y="8" width="4" height="13" rx=".5"/><rect x="17" y="3" width="4" height="18" rx=".5"/></>}
  {category === "time-intelligence" && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2" /></>}
  {category === "service" && <><path d="M6.5 18.5H18a4 4 0 0 0 .4-8 6.9 6.9 0 0 0-13.3 1.5A3.3 3.3 0 0 0 6.5 18.5Z" /></>}
</svg>
