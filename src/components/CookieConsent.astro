---
// Lightweight GDPR cookie consent banner — no external dependencies
// Uses localStorage to remember user choice
---

<div id="cookie-consent" class="cookie-consent" hidden>
  <div class="cookie-consent__inner">
    <p class="cookie-consent__text">
      This website uses cookies for analytics and advertising. By continuing to use this site, you agree to our use of cookies.
      <a href="/privacy" class="cookie-consent__link">Privacy Policy</a>
    </p>
    <div class="cookie-consent__actions">
      <button id="cookie-accept" class="cookie-consent__btn cookie-consent__btn--primary" type="button">
        Accept
      </button>
      <button id="cookie-decline" class="cookie-consent__btn cookie-consent__btn--secondary" type="button">
        Decline
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'cookie-consent-v1';
    var banner = document.getElementById('cookie-consent');
    if (!banner) return;

    try {
      var saved = localStorage.getItem(KEY);
      if (saved === 'accepted' || saved === 'declined') {
        banner.remove();
        return;
      }
    } catch (e) {}

    banner.hidden = false;

    function setConsent(value) {
      try { localStorage.setItem(KEY, value); } catch (e) {}
      banner.classList.add('cookie-consent--leaving');
      setTimeout(function () { banner.remove(); }, 300);
    }

    document.getElementById('cookie-accept')?.addEventListener('click', function () {
      setConsent('accepted');
    });
    document.getElementById('cookie-decline')?.addEventListener('click', function () {
      setConsent('declined');
    });
  })();
</script>

<style>
  .cookie-consent {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: #1a1a2e;
    color: #e8e8e8;
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.15);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .cookie-consent--leaving {
    opacity: 0;
    transform: translateY(100%);
  }
  .cookie-consent__inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 16px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .cookie-consent__text {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    flex: 1;
    min-width: 240px;
  }
  .cookie-consent__link {
    color: #7c9eff;
    text-decoration: underline;
  }
  .cookie-consent__link:hover {
    color: #a5b9ff;
  }
  .cookie-consent__actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .cookie-consent__btn {
    padding: 8px 20px;
    border: none;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .cookie-consent__btn--primary {
    background: #4f46e5;
    color: #ffffff;
  }
  .cookie-consent__btn--primary:hover {
    background: #4338ca;
  }
  .cookie-consent__btn--secondary {
    background: transparent;
    color: #e8e8e8;
    border: 1px solid #555;
  }
  .cookie-consent__btn--secondary:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 600px) {
    .cookie-consent__inner {
      flex-direction: column;
      align-items: stretch;
      padding: 14px 16px;
    }
    .cookie-consent__actions {
      justify-content: flex-end;
    }
  }
</style>
