---
import { PRODUCTS } from "../consts";

export interface Props {
  category: string;
  tags?: string[];
}

const { category, tags = [] } = Astro.props;

const scored = PRODUCTS
  .map((p) => {
    let score = p.categories.includes(category) ? 2 : 0;
    score += (p.tags || []).filter((t) => tags.includes(t)).length;
    return { product: p, score };
  })
  .filter((x) => x.score > 0)
  .sort((a, b) => b.score - a.score);

const pick = scored[0]?.product;
if (!pick) return null;
---

<aside class="rp-card">
  <div class="rp-body">
    <span class="rp-eyebrow">{pick.kind}</span>
    <h3>{pick.name}</h3>
    <p class="rp-blurb">{pick.blurb}</p>
  </div>
  <a class="rp-cta" href={pick.landing} data-product-cta={pick.slug}>
    {pick.ctaLabel}
  </a>
</aside>

<script is:inline>
  document.addEventListener("click", function (e) {
    var el = e.target.closest("[data-product-cta]");
    if (!el) return;
    if (typeof window.gtag === "function") {
      window.gtag("event", "product_cta_click", {
        product: el.getAttribute("data-product-cta"),
        location: "tutorial_inline",
      });
    }
  });
</script>

<style>
  .rp-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 28px 0;
    padding: 20px 24px;
    border: 1px solid var(--c-accent);
    border-radius: 10px;
    background: var(--c-bg);
    flex-wrap: wrap;
  }
  .rp-eyebrow {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-accent-dark);
  }
  .rp-card h3 { margin: 4px 0 6px; font-size: 1.05rem; }
  .rp-blurb {
    margin: 0;
    font-size: 0.88rem;
    color: var(--c-text-muted);
    max-width: 460px;
  }
  .rp-cta {
    flex: 0 0 auto;
    padding: 11px 20px;
    border-radius: 7px;
    background: var(--c-accent);
    color: var(--c-accent-text);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .rp-cta:hover { background: var(--c-accent-dark); text-decoration: none; }
</style>
